// 4. FULL FEATURE SPACE MACHINE LEARNING GENERATOR
function createComprehensiveStack(year, s2Collection, isTOA) {
  var startDate = year + '-01-01';
  var endDate = year + '-12-31';
  
  var baseS2 = ee.ImageCollection(s2Collection)
    .filterBounds(geometry_clean)
    .filterDate(startDate, endDate)
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30)); // Strict 30% cloud filter
    
  var s2Median;
  if (!isTOA) {
    s2Median = baseS2.map(maskS2_SR).median().clip(geometry_clean);
  } else {
    // Standardization fix for early 2015 archive variations before mosaic reduction
    s2Median = baseS2.select(['B2','B3','B4','B5','B6','B7','B8','B8A','B11','B12'])
                     .median().divide(10000).clip(geometry_clean);
  }
  
  // Index Suite Processing
  var ndvi = s2Median.normalizedDifference(['B8','B4']).rename('NDVI');
  var ndre = s2Median.normalizedDifference(['B7','B5']).rename('NDRE');
  var ndmi = s2Median.normalizedDifference(['B8','B11']).rename('NDMI');
  var mndwi = s2Median.normalizedDifference(['B3','B11']).rename('MNDWI');
  var savi = s2Median.expression('((B8-B4)/(B8+B4+0.5))*1.5', {'B8':s2Median.select('B8'),'B4':s2Median.select('B4')}).rename('SAVI');
  var cmri = ndvi.subtract(mndwi).rename('CMRI');
  
  var baseS1 = ee.ImageCollection('COPERNICUS/S1_GRD')
    .filterBounds(geometry_clean)
    .filterDate(startDate, endDate)
    .filter(ee.Filter.eq('instrumentMode','IW'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
    .select(['VV','VH'])
    .median();
    
  var vh_diff = baseS1.select('VV').subtract(baseS1.select('VH')).rename('VHdB').clip(geometry_clean);
  var vv_vh = baseS1.select('VV').divide(baseS1.select('VH')).rename('VV_VH_Ratio').clip(geometry_clean);
  var logVV = baseS1.select('VV').abs().log().rename('log_VV').clip(geometry_clean);
  var logVH = baseS1.select('VH').abs().log().rename('log_VH').clip(geometry_clean);
  var canopyHeight = baseS1.select('VH').abs().multiply(ndre).multiply(20).add(3).rename('CHT').clip(geometry_clean);
  
  // Full 8-Band Radar Texture Calculations
  var radarInt = baseS1.select('VH').add(30).multiply(10).toInt(); 
  var glcm = radarInt.glcmTexture({size: 5}).clip(geometry_clean);
  
  var masterImage = ee.Image.cat([
    s2Median.select(['B2','B3','B4','B5','B6','B7','B8','B8A','B11','B12']),
    ndvi, ndre, ndmi, mndwi, savi, cmri,
    baseS1.clip(geometry_clean).select(['VV','VH']), vh_diff, vv_vh, logVV, logVH,
    dem, slope, aspect, canopyHeight,
    glcm.select(['VH_asm','VH_contrast','VH_corr','VH_ent','VH_idm','VH_diss','VH_savg','VH_var'])
  ]).select(bandList);
  
  // Post-Prediction Ecological Mangrove Mask Base
  var baselineMangrove = ee.ImageCollection('LANDSAT/MANGROVE_FORESTS').mosaic().select('1').gt(0).unmask(0);
  var dynamicMangroveMask = cmri.gt(0.12).and(dem.lt(15)); 
  var ecologicalMask = baselineMangrove.or(dynamicMangroveMask);
  
  return {
    stack: masterImage,
    mask: ecologicalMask
  };
}

